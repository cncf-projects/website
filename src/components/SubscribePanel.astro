---
import { categoryFeedUrl, discussionsUrl, repositoryFeedUrl } from '../lib/feeds';
import { decimal } from '../lib/format';
import type { RepositoryView } from '../lib/snapshot';

interface Props {
  view: RepositoryView;
}

const { view } = Astro.props;
const { repository, label, snapshot } = view;
const id = `subscribe-${repository.owner}-${repository.name}`;
---

<section class="subscribe-panel" aria-labelledby={id}>
  <div class="subscribe-lead">
    <h2 id={id}>Subscribe to {label}</h2>
    <p>
      Every discussion board and every category publishes an Atom feed. Feeds need no
      token and no account, and they update the moment somebody posts, rather than when
      this page is next built.
    </p>
    <a class="subscribe subscribe-primary" href={repositoryFeedUrl(repository)}>
      Subscribe to all discussions
    </a>
    <p class="feed-url"><code>{repositoryFeedUrl(repository)}</code></p>
  </div>

  <div class="subscribe-categories">
    <h3>Per-category feeds</h3>
    {snapshot.categories.length > 0 ? (
      <>
        <p class="muted">Each category publishes its own feed.</p>
        <ul class="category-feeds">
          {snapshot.categories.map((category) => (
            <li>
              <a class="subscribe subscribe-category" href={categoryFeedUrl(repository, category)}>
                {category.name}
              </a>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <p class="muted">
        Categories could not be read when this page was built. The board feed above still
        covers every category.
      </p>
    )}
  </div>

  <p class="detail-meta">
    <a href={discussionsUrl(repository)}>Open the discussion board on GitHub</a>
    <span class="muted">
      {snapshot.requests > 0
        ? ` Read in ${decimal.format(snapshot.requests)} API request(s).`
        : ' No API requests were made for this repository.'}
    </span>
  </p>
</section>
