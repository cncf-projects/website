---
import { discussionsUrl, repositoryFeedUrl } from '../lib/feeds';
import { decimal, duration, percent, present } from '../lib/format';
import type { RepositoryView } from '../lib/snapshot';
import { sparkline } from '../lib/sparkline';

interface Props {
  view: RepositoryView;
}

const { view } = Astro.props;
const { summary, snapshot, label, repository } = view;

const series = summary.series.state === 'ok' ? summary.series.value : null;
const chart = series ? sparkline(series.buckets) : null;
const bucketDays = series ? Math.round(series.bucketDays) : 0;

const trend = summary.trend.state === 'ok' ? summary.trend.value : null;
const direction = !trend ? 'flat' : trend.change > 0 ? 'up' : trend.change < 0 ? 'down' : 'flat';
const trendText = !trend
  ? present(summary.trend, () => '').text
  : trend.change === 0
    ? 'No change'
    : `${trend.change > 0 ? '+' : '\u2212'}${
        trend.ratio === null
          ? decimal.format(Math.abs(trend.change))
          : percent.format(Math.abs(trend.ratio))
      }`;

const cells = [
  present(summary.participants, (value) => decimal.format(value)),
  present(summary.discussionsOpened, (value) => decimal.format(value)),
  present(summary.comments, (value) => decimal.format(value)),
  present(
    summary.answered,
    (value) => `${percent.format(value.ratio)} of ${value.answered + value.unanswered}`,
    'No questions',
  ),
  present(summary.medianFirstResponse, (value) => duration(value), 'No responses'),
  present(summary.cohorts, (value) => `${value.newcomers} / ${value.returning}`),
  present(summary.topCategory, (value) => value.names.join(', ')),
];
const columns = [
  'participants',
  'discussions',
  'comments',
  'answered',
  'response',
  'cohorts',
  'category',
];

const errors = [...new Set(snapshot.errors)];
const status = errors.length > 0
  ? errors.join(' ')
  : `Read ${decimal.format(snapshot.discussions.length)} discussions${
      snapshot.historyComplete ? '' : ' (history incomplete)'
    }`;
---

<tr>
  <th scope="row" class="col-repo">
    <a href={discussionsUrl(repository)}>{label}</a>
    <span class:list={['row-status', { 'row-status-error': errors.length > 0 }]}>{status}</span>
  </th>

  <td class="col-subscribe">
    <a class="subscribe subscribe-row" href={repositoryFeedUrl(repository)}>Subscribe</a>
  </td>

  <td class="col-spark">
    {chart ? (
      <svg
        class="sparkline"
        viewBox={`0 0 ${chart.width} ${chart.height}`}
        width={chart.width}
        height={chart.height}
        preserveAspectRatio="none"
        role="img"
        aria-label={`Discussion activity for ${label}: ${series!.buckets.join(', ')} contributions per ${bucketDays}-day period, oldest first. Peak ${chart.peak}.`}
      >
        <path class="sparkline-area" d={chart.area} />
        <polyline class="sparkline-line" points={chart.line} />
      </svg>
    ) : (
      <span class="cell-empty" title={present(summary.series, () => '').title}>
        {present(summary.series, () => '').text}
      </span>
    )}
  </td>

  <td class="col-trend">
    <span
      class:list={['trend', trend ? `trend-${direction}` : 'cell-empty']}
      title={trend
        ? `${trend.current} contributions this window against ${trend.previous} in the previous one.`
        : present(summary.trend, () => '').title}
    >{trendText}</span>
  </td>

  {cells.map((cell, index) => (
    <td class={`col-${columns[index]}`}>
      <span class:list={[{ 'cell-empty': cell.empty }]} title={cell.title || undefined}>
        {cell.text}
      </span>
    </td>
  ))}
</tr>
